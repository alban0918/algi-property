# URL pública del sitio, usada para canónicas, sitemap y Open Graph.
# En Vercel: Settings > Environment Variables. Sin barra final.
NEXT_PUBLIC_SITE_URL=https://www.algiproperty.com

# ── Registro de interesados (descarga de fichas técnicas) ──────────────────────
# Copiar este archivo a .env.local para desarrollo, y crear las mismas variables en Vercel.
# Ninguna de estas claves va al repositorio.

# Secreto para firmar los enlaces de descarga (mínimo 32 caracteres, aleatorio).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FICHAS_SECRETO=

# Conexión a Postgres en Neon (Dashboard > Connect). Usar la cadena "pooled".
DATABASE_URL=

# Resend: clave de API y remitente de un dominio verificado en Resend (algiproperty.com).
RESEND_API_KEY=
AVISOS_REMITENTE=ALGI Property <avisos@algiproperty.com>
# Correo(s) que reciben el aviso de cada interesado, separados por coma. Puede ser un correo normal.
AVISOS_DESTINO=

# Solo para las pruebas automáticas (sin base de datos ni correo). Nunca activar en Vercel.
# LEADS_MODO=prueba
